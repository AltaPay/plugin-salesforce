<?xml version="1.0" encoding="UTF-8"?>
<services xmlns="http://www.demandware.com/xml/impex/services/2014-09-26">
    

    <service-credential service-credential-id="int.marketpay.service.credential">
        <url>https://testgateway.altapaysecure.com</url>
        <user-id></user-id>
        <password encrypted="true" encryption-type="common.export"></password>
    </service-credential>

    <service-credential service-credential-id="int.marketpay.slas.credentials">
        <url>https://{shortcode}.api.commercecloud.salesforce.com</url>
        <user-id></user-id>
        <password encrypted="true" encryption-type="common.export"></password>
    </service-credential>

    <service-profile service-profile-id="int.maketpay.service.profile">
        <timeout-millis>3000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>0</cb-calls>
        <cb-millis>0</cb-millis>
    </service-profile>

    <service-profile service-profile-id="int.marketpay.slas.profile">
        <timeout-millis>5000</timeout-millis>
        <rate-limit-enabled>false</rate-limit-enabled>
        <rate-limit-calls>0</rate-limit-calls>
        <rate-limit-millis>0</rate-limit-millis>
        <cb-enabled>true</cb-enabled>
        <cb-calls>0</cb-calls>
        <cb-millis>0</cb-millis>
    </service-profile>

    <service service-id="int.marketpay.slas">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix/>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>true</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>int.marketpay.slas.profile</profile-id>
        <credential-id>int.marketpay.slas.credentials</credential-id>
    </service>

    <service service-id="int.marketpay.service">
        <service-type>HTTP</service-type>
        <enabled>true</enabled>
        <log-prefix/>
        <comm-log-enabled>false</comm-log-enabled>
        <force-prd-enabled>true</force-prd-enabled>
        <mock-mode-enabled>false</mock-mode-enabled>
        <profile-id>int.maketpay.service.profile</profile-id>
        <credential-id>int.marketpay.service.credential</credential-id>
    </service>
</services>
