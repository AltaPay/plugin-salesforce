<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <type-extension type-id="Order">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="marketPayTransactionId">
                <display-name xml:lang="x-default">Transaction ID</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayPaymentId">
                <display-name xml:lang="x-default">Payment ID</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayReservedAmount">
                <display-name xml:lang="x-default">Reserved Amount</display-name>
                <type>double</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayCapturedAmount">
                <display-name xml:lang="x-default">Captured Amount</display-name>
                <type>double</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayRefundedAmount">
                <display-name xml:lang="x-default">Refunded Amount</display-name>
                <type>double</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayKnownIPProtection">
                <display-name xml:lang="x-default">Restricts callbacks to known gateway IP
                    addresses. Disable this option if the store is using a firewall or proxy service
                    (such as Cloudflare).</display-name>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayError">
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayErrorMessage">
                <display-name xml:lang="x-default">Error Message</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayUserLocale">
                <display-name xml:lang="x-default">User Locale</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="MarketPay">
                <display-name xml:lang="x-default">MarketPay</display-name>
                <attribute attribute-id="marketPayTransactionId" />
                <attribute attribute-id="marketPayPaymentId" />
                <attribute attribute-id="marketPayReservedAmount" />
                <attribute attribute-id="marketPayCapturedAmount" />
                <attribute attribute-id="marketPayRefundedAmount" />
                <attribute attribute-id="marketPayKnownIPProtection" />
                <attribute attribute-id="marketPayError" />
                <attribute attribute-id="marketPayErrorMessage" />
                <attribute attribute-id="marketPayUserLocale" />
            </attribute-group>
        </group-definitions>
    </type-extension>
    <type-extension type-id="OrderPaymentInstrument">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="marketPayPaymentMethodID">
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayPlatform">
                <type>enum-of-string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <value-definitions>
                    <value-definition default="true">
                        <display xml:lang="x-default">web</display>
                        <value>web</value>
                    </value-definition>
                    <value-definition>
                        <display xml:lang="x-default">app</display>
                        <value>app</value>
                    </value-definition>
                </value-definitions>
            </attribute-definition>
            <attribute-definition attribute-id="marketTransactionID">
                <display-name xml:lang="x-default">Transaction ID</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>true</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="MarketPay">
                <display-name xml:lang="x-default">MarketPay</display-name>
                <attribute attribute-id="marketPayPaymentMethodID" />
                <attribute attribute-id="marketPayPlatform" />
                <attribute attribute-id="marketTransactionID" />
            </attribute-group>
        </group-definitions>
    </type-extension>
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="marketPayAppURL">
                <display-name xml:lang="x-default">App URL</display-name>
                <description xml:lang="x-default">This is an app URL where the customer will be
                    redirected from wallet payment app when a payment fails or succeeds.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayKnownIPProtection">
                <display-name xml:lang="x-default">Known IP Protection</display-name>
                <description xml:lang="x-default">Restricts callbacks to known gateway IP addresses.
                    Disable this option if the store is using a firewall or proxy service (such as
                    Cloudflare)</description>
                <type>boolean</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <default-value>false</default-value>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayOrganizationID">
                <display-name xml:lang="x-default">Organization ID</display-name>
                <description xml:lang="x-default">Organization ID of the your current instance</description>
                <type>string</type>
                <mandatory-flag>true</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayOrganizationShortCode">
                <display-name xml:lang="x-default">Short Code</display-name>
                <description xml:lang="x-default">Your Organization's Short Code</description>
                <type>string</type>
                <mandatory-flag>true</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayPaymentFailedURL">
                <display-name xml:lang="x-default">Payment Failed URL</display-name>
                <description xml:lang="x-default">URL where MarketPay Redirects After Failed Payment</description>
                <type>string</type>
                <mandatory-flag>true</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayPaymentSuccessURL">
                <display-name xml:lang="x-default">Payment Success URL</display-name>
                <description xml:lang="x-default">URL where MarketPay Redirects After Successful
                    Payment</description>
                <type>string</type>
                <mandatory-flag>true</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="marketPayTerminals">
                <display-name xml:lang="x-default">MarketPay Terminals</display-name>
                <description xml:lang="x-default">Used for mapping of payment methods in Salesforce
                    and terminals in the MarketPay payment gateway</description>
                <type>text</type>
                <mandatory-flag>true</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="MarketPay">
                <display-name xml:lang="x-default">MarketPay</display-name>
                <attribute attribute-id="marketPayTerminals" />
                <attribute attribute-id="marketPayPaymentSuccessURL" />
                <attribute attribute-id="marketPayPaymentFailedURL" />
                <attribute attribute-id="marketPayAppURL" />
                <attribute attribute-id="marketPayOrganizationID" />
                <attribute attribute-id="marketPayOrganizationShortCode" />
                <attribute attribute-id="marketPayKnownIPProtection" />
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>